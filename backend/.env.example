# ============================================================
# Mentorly Backend - Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env to git.
# ============================================================

PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:8080

# MongoDB Atlas
# NOTE: the database name stays `mentorconnect` — it is an internal
# identifier shared with the existing data. Do not rename it.
DATABASE_URL=mongodb+srv://<user>:<password>@cluster0.xxx.mongodb.net/mentorconnect?retryWrites=true&w=majority

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_JWKS_URL=https://<your-clerk-domain>/.well-known/jwks.json

# Gemini AI (Matching Engine)
GEMINI_API_KEY=

# Ollama (LLM ranking — prompt-based, local llama3.2:3b; no fine-tuning)
# Base URL of the local Ollama server (default http://localhost:11434).
OLLAMA_BASE_URL=http://localhost:11434
# Model used for ranking (default llama3.2:3b).
OLLAMA_MODEL=llama3.2:3b
# Per-request timeout in ms (default 15000).
OLLAMA_TIMEOUT_MS=15000
# Set to false to disable LLM ranking and use deterministic scores only (default true).
LLM_RANKING_ENABLED=true
# AI-refined mentorship request summaries (local Llama, POST /requests).
# Set to false to skip refinement and keep the student's original text only (default true).
LLM_REFINEMENT_ENABLED=true

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM="Mentorly <noreply@example.com>"

# ============================================================
# MSG91 Phone OTP Verification
# ============================================================
# 1. Sign up at https://msg91.com
# 2. Create an OTP template in MSG91 dashboard with message:
#    "Mentorly verification code is ##OTP##. Valid for 5 minutes. Do not share this code with anyone."
# 3. Complete DLT registration if sending to Indian numbers (mandatory for India).
# 4. Copy the Auth Key and Template ID from MSG91 dashboard.
# 5. Set MSG91_ENABLED=true for production.
# ============================================================
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# Widget ID for MSG91 Widget-mode OTP. The backend uses Widget mode when
# MSG91_OTP_TEMPLATE_ID is empty and this is set (see msg91.service.ts).
MSG91_WIDGET_ID=
# Must match your DLT-registered sender ID.
MSG91_SENDER_ID=
MSG91_OTP_EXPIRY_SECONDS=300
MSG91_OTP_RESEND_COOLDOWN_SECONDS=30
MSG91_OTP_MAX_ATTEMPTS=5
MSG91_OTP_MAX_SENDS_PER_HOUR=5
MSG91_API_BASE_URL=https://control.msg91.com/api/v5
# Set to true in production. false enables dev simulation mode (only works when NODE_ENV=development).
MSG91_ENABLED=true
# Development only - OTP to accept when MSG91_ENABLED=false (never used in production)
DEV_PHONE_OTP=123456

# File Storage (AWS S3 / Cloudflare R2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=mentorly-assets

# Google Calendar Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/calendar/oauth/callback
