# Mentorly Next.js app — environment setup.
# Copy this file to `.env.local` in this folder and fill in REAL values.
# NEVER commit `.env.local`, and never paste a real key into any other file.
#
# Variable NAMES match the React app's vite.config.js `define` block exactly.
# In the React app Vite inlines them at build time; in Next.js they are read
# from `.env.local` at build time (NEXT_PUBLIC_* vars are embedded in the
# browser bundle, so only publishable/client-safe values belong here).
#
# Where Somesh gets each value:
# - NEXT_PUBLIC_API_URL: the local backend default below (no secret).
# - NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY: Clerk dashboard (same publishable key
#   the React app uses — see the fallback in the React app's vite.config.js).
# - NEXT_PUBLIC_MSG91_WIDGET_ID / NEXT_PUBLIC_MSG91_TOKEN_AUTH: MSG91
#   dashboard. NOTE: no frontend src/ file currently reads these two — OTP
#   goes through the backend. They are listed for parity with vite.config.js
#   so a future frontend MSG91 use has the names ready.

NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
NEXT_PUBLIC_MSG91_WIDGET_ID=REPLACE_ME
NEXT_PUBLIC_MSG91_TOKEN_AUTH=REPLACE_ME
